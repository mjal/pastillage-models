(* -lib common.pvl *)

let Tally(bb: bb_t) =
  get CREDENTIALS(=Alice, cred_Alice, _) in
  get CREDENTIALS(=Bob, cred_Bob, _) in
  get BULLETIN_BOARD(=bb, =cred_Alice, b_Alice) in
  get BULLETIN_BOARD(=bb, =cred_Bob, b_Bob) in
  let (c_Alice:bitstring, sig_Alice:sig_t, zkp_Alice:zkp_t) = b_Alice in
  let (c_Bob:bitstring, sig_Bob:sig_t, zkp_Bob:zkp_t) = b_Bob in

  ( out(mixnet,choice[c_Alice,c_Bob])
  | out(mixnet,choice[c_Bob,c_Alice])
  |(
    in(mixnet,c1:bitstring) [precise];
    in(mixnet,c2:bitstring) [precise];

    (* Decrypt Alice and Bob ballots *)
    out(public,(adec(c1,sk_e),adec(c2,sk_e)));
    event Tallied(bb);
    !(
      (* Decrypt other ballots *)
      in(public,cred:spkey);
      if (cred <> cred_Alice && cred <> cred_Bob) then
      get BULLETIN_BOARD(=bb, =cred, c) in
      out(public, adec(c,sk_e))
    )
  ))
  .

(* -- Executability check -- *)
lemma event(Tallied(makeBB(attr(AttrA),attr(AttrB),attr(Attr0),attr(Attr0)))) [maxSubset]. (* BB1 *)
lemma event(Tallied(makeBB(attr(AttrC),attr(AttrD),attr(Attr0),attr(Attr0)))) [maxSubset]. (* BB2 *)

(* -- Main process -- *)
process
  let property = X in
  let status_server = honest in
  let status_reg = corrupt in

  new scred_Alice:sskey;
  new scred_Bob:sskey;

  out(public, (pk_e));
  out(public, (attr(AttrA), attr(AttrB), attr(AttrC), attr(AttrD)))

  | (
    if (property = X) then (
      in(public, a:attr_t) [precise];
      if (is_attr(a)) then
      
      Registrar(Alice, scred_Alice, a, status_reg)
      | Registrar(Bob, scred_Bob, a, status_reg)
    )
    else if (property = Xattrs) then (
      in(public, (a1:attr_t, a2:attr_t)) [precise];
      if (is_attr(a1) && is_attr(a2)) then

      (* a1 and a2 still need to vote in the same ballot boxes *)
      if (a1 = a2 || (a1 = attr(AttrA) && a2 = attr(AttrB)) || (a2 = attr(AttrA) && a1 = attr(AttrB))
        || (a1 = attr(AttrC) && a2 = attr(AttrD)) || (a2 = attr(AttrC) && a1 = attr(AttrD))) then

      Registrar(Alice, scred_Alice, a1, status_reg)
      | Registrar(Bob, scred_Bob, a2, status_reg)
    )
  )

  | Client(Alice, choice[A,B])   | Client(Bob, choice[B,A])
  | Server(Alice, status_server) | Server(Bob, status_server)
  (* | Dispatch(Alice) | Dispatch(Bob) *)
  | DispatchAll()
  | Tally(BB1) | Tally(BB2)

  | out(public, c_server(Alice)) | out(public, c_server(Bob)) (* for privacy, no need for an authenticated channel *)

  (* Dishonest voters (controlled by the attacker) *)
  | !(
    in(public, (id:id_t, a:attr_t));
    if (id <> Alice && id <> Bob) then (
      new scred:sskey;
      Registrar(id, scred, a, status_reg)
      | Server(id, status_server)
      | out(public, (c_reg(id), c_server(id)))
    )
  )

  (* Public bulletin board, readable by anyone *)
  | !(
    get BULLETIN_BOARD(bb, cred, b) in
    out(public, (cred, b))
  )
